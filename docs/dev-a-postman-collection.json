  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Ambil CSRF & Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let xsrfToken = pm.cookies.get('XSRF-TOKEN');",
                  "if (!xsrfToken) {",
                  "    const setCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie');",
                  "    const xsrfCookie = setCookie.find(h => h.value.includes('XSRF-TOKEN='));",
                  "    if (xsrfCookie) {",
                  "        const match = xsrfCookie.value.match(/XSRF-TOKEN=([^;]+)/);",
                  "        if (match) {",
                  "            xsrfToken = match[1];",
                  "        }",
                  "    }",
                  "}",
                  "if (xsrfToken) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(xsrfToken));",
                  "    console.log('XSRF token updated');",
                  "} else {",
                  "    console.warn('XSRF token tidak ditemukan. Pastikan request /login sukses.');",
                  "}",
                  "pm.test('Status 200 untuk ambil session', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Jalankan dulu request ini agar Postman menerima cookie `laravel_session` dan `XSRF-TOKEN` seperti browser."
          }
        },
        {
          "name": "Login API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login sukses', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "let xsrfToken = pm.cookies.get('XSRF-TOKEN') || pm.collectionVariables.get('xsrf_token');",
                  "if (xsrfToken) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(xsrfToken));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"remember\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login session-based yang mengikuti perilaku web asli. Jalankan setelah `Ambil CSRF & Session`."
          }
        },
